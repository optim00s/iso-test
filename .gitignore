# Generated build output and local VM sources; retain empty-folder markers/docs.
/work/*
!/work/.gitkeep
/output/*
!/output/.gitkeep
/vm-source/*
!/vm-source/README.md

# Binary assets stay local. Keep instructions and integrity metadata.
/assets/**
!/assets/**/
!/assets/README.md
!/assets/linux/README.txt
!/assets/linux/*-SHA256SUMS
!/assets/linux/*.sha256
!/assets/linux/TypeB-Ubuntu-22.04-WSL-Docker.tar.baseline.json
!/assets/office/configuration.xml
!/assets/office/SHA256SUMS
!/assets/updates/README.txt
!/assets/vsix/PUT-VSIX-HERE.txt
!/assets/windows/.gitkeep
!/assets/windows/*.sha256
!/assets/windows/TerminalDependencies/*.sha256

/source/*
!/source/README.txt
!/source/*.sha256

# Defense against binary payloads being placed elsewhere.
*.iso
*.exe
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.vsix
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.cab
*.msu
*.vmdk
*.vhd
*.vhdx
*.vmx
*.vmxf
*.nvram
*.vmsd
*.vmsn
*.vmss
*.vmem
*.lck/
*.log
*.partial
*.tmp

# Local credentials and tooling state.
.env
.env.*
!.env.example
/.codex/
/.aws/
/.ssh/
*.pem
*.key
*.pfx
*.p12
__pycache__/
.DS_Store
Thumbs.db
